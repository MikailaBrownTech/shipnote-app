NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Sign-in alert emails (off unless ALERTS_ENABLED=true; then all three are required).
ALERTS_ENABLED=false
RESEND_API_KEY=
EMAIL_FROM=
DEVICE_HASH_SALT=

# GitHub connection (off unless GITHUB_ENABLED=true; then all five below are required).
# Server only. The private key is the App's PEM file, base64-encoded (see the README).
GITHUB_ENABLED=false
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=

# Draft generation with Claude (off unless AI_ENABLED=true; then ANTHROPIC_API_KEY is required).
# Server only. ANTHROPIC_MODEL is claude-sonnet-5-5 (default) or claude-haiku-5-5.
# AI_MONTHLY_CAP_USD is the most spent across all users in a month (default 10).
AI_ENABLED=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
AI_MONTHLY_CAP_USD=

# Scheduling a draft on LinkedIn through each user's own Buffer account (off
# unless SCHEDULING_ENABLED=true; this is the kill switch). Server only.
# BUFFER_TOKEN_ENCRYPTION_KEY is base64 of 32 random bytes (see the README).
# Only change BUFFER_TOKEN_KEY_VERSION and fill _PREVIOUS while rotating it.
SCHEDULING_ENABLED=false
BUFFER_CLIENT_ID=
BUFFER_CLIENT_SECRET=
BUFFER_TOKEN_ENCRYPTION_KEY=
BUFFER_TOKEN_KEY_VERSION=
BUFFER_TOKEN_ENCRYPTION_KEY_PREVIOUS=

# Automatic drafts from [post] commits (off unless AUTO_DRAFTS_ENABLED=true; this
# is the kill switch). Needs GITHUB_ENABLED and AI_ENABLED on too. Server only.
# GITHUB_WEBHOOK_SECRET is the secret you set on the GitHub App's webhook.
# The QStash values come from the QStash tab in the Upstash console. QSTASH_URL
# is optional: leave it empty unless your account uses a regional address.
AUTO_DRAFTS_ENABLED=false
GITHUB_WEBHOOK_SECRET=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
QSTASH_URL=
