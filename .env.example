NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Sign-in alert emails (off unless ALERTS_ENABLED=true; then all three are required).
ALERTS_ENABLED=false
RESEND_API_KEY=
EMAIL_FROM=
DEVICE_HASH_SALT=

# GitHub connection (off unless GITHUB_ENABLED=true; then all five below are required).
# Server only. The private key is the App's PEM file, base64-encoded (see the README).
GITHUB_ENABLED=false
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=

# Draft generation with Claude (off unless AI_ENABLED=true; then ANTHROPIC_API_KEY is required).
# Server only. ANTHROPIC_MODEL is claude-sonnet-5-5 (default) or claude-haiku-5-5.
# AI_MONTHLY_CAP_USD is the most spent across all users in a month (default 10).
AI_ENABLED=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
AI_MONTHLY_CAP_USD=
